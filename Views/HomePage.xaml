<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:ExpenseTracker.Resources.Strings"
             xmlns:viewmodels="clr-namespace:ExpenseTracker.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Models"
             xmlns:views="clr-namespace:ExpenseTracker.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="ExpenseTracker.Views.HomePage"
             x:Name="MyHomePage"
             Title="{x:Static strings:AppResources.HomePageTitle}"
             BackgroundColor="{DynamicResource AppBackgroundColor}">

    <Grid>

        <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Margin="20,20,20,0">

            <Label Grid.Row="0" Text="{x:Static strings:AppResources.TotalBalanceLabel}" FontSize="20" FontAttributes="Bold" Margin="0,0,0,10" TextColor="{DynamicResource AppTextColor}"/>

            <!-- 1. SelectionMode="None" - wyłączamy wbudowane zaznaczanie i usuwamy SelectedItem -->
            <CollectionView Grid.Row="1" 
                ItemsSource="{Binding AccountsBalances}" 
                HeightRequest="110" 
                HorizontalScrollBarVisibility="Always" 
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <!-- 2. Wskazujemy kompilatorowi, z jakim modelem danych mamy do czynienia wewnątrz listy -->
                    <DataTemplate x:DataType="viewmodels:AccountBalanceItem">
                        <Border WidthRequest="150" Padding="15" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{DynamicResource SectionBackgroundColor}">

                            <!-- 3. NOWOŚĆ: Reakcja na kliknięcie -->
                            <Border.GestureRecognizers>
                                <!-- Tłumaczenie magii poniżej:
                         "Poszukaj komendy AccountTappedCommand w HomeViewModel (bo jesteśmy wewnątrz AccountBalanceItem), 
                         i jako parametr prześlij samego siebie ({Binding .})" -->
                                <TapGestureRecognizer 
                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=AccountTappedCommand}"
                        CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontSize="15" TextColor="{DynamicResource AppTextColor}" Opacity="0.8" LineBreakMode="TailTruncation"/>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding Balance, StringFormat='{0:N2}'}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource PrimaryColor}" />
                                    <Label Text="{Binding Currency}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource PrimaryColor}" VerticalOptions="End" Margin="0,0,0,3"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


            <Border Grid.Row="2" Margin="0,20,0,0" Padding="20,15" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{DynamicResource PrimaryColor}">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="{x:Static strings:AppResources.NetWorthLabel}" TextColor="{DynamicResource HeaderTextColor}" VerticalOptions="Center" FontSize="16" FontAttributes="Bold"/>
                    <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                        <Label Grid.Column="1" Text="{Binding TotalNetWorthDisplay}" FontAttributes="Bold" FontSize="20" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HasMissingRates}" Value="True">
                                    <Setter Property="TextColor" Value="#D32F2F" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding HasMissingRates}" Value="False">
                                    <Setter Property="TextColor" Value="{DynamicResource HeaderTextColor}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="ⓘ" FontSize="28" TextColor="#D32F2F" VerticalOptions="Center" IsVisible="{Binding HasMissingRates}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowMissingRatesInfoCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- SEKCJA WYKRESU BIEŻĄCEGO MIESIĄCA -->
            <Border Grid.Row="3" Margin="0,20,0,0" Padding="15" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{DynamicResource SectionBackgroundColor}">
                <Grid RowDefinitions="Auto, 160" ColumnDefinitions="Auto, *">

                    <!-- Nagłówek rozciągnięty na obie kolumny -->
                    <Label Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static strings:AppResources.CurrentMonthExpensesLabel}" FontAttributes="Bold" FontSize="16" TextColor="{DynamicResource AppTextColor}" Margin="0,0,0,10"/>

                    <!-- KOLUMNA 1: Czysty wykres (Kwadrat 180x180) + Wyśrodkowany tekst -->
                    <Grid Grid.Row="1" Grid.Column="0" WidthRequest="160" HeightRequest="160">

                        <!-- ZMIANA: LegendPosition="Hidden" - wyłączamy wbudowaną legendę SkiaSharp -->
                        <lvc:PieChart Series="{Binding ExpenseSeries}" 
                                      LegendPosition="Hidden" 
                                      TooltipPosition="Hidden"
                                      BackgroundColor="Transparent" />

                        <!-- ZMIANA: Usunięto sztuczny Margines. Tekst centruje się teraz samoczynnie w kwadracie -->
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True" IsVisible="{Binding HasExpensesThisMonth}">
                            <Label Text="{Binding CurrentMonthTotalDisplay}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- KOLUMNA 2: Natywna legenda MAUI renderowana obok wykresu -->
                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" VerticalOptions="Center" Margin="15,0,0,0" Spacing="10"
                                         BindableLayout.ItemsSource="{Binding ExpenseLegend}" 
                                         IsVisible="{Binding HasExpensesThisMonth}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ExpenseLegendItem">
                                <Grid ColumnDefinitions="Auto,Auto, *" RowDefinitions="Auto, Auto" ColumnSpacing="8">
                                    <!-- Kolorowa kropka kategorii -->
                                    <Ellipse Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" WidthRequest="10" HeightRequest="10" Fill="{Binding DotColor}" VerticalOptions="Center"/>

                                    <!-- Nazwa (zawija się jeśli jest za długa) -->
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" LineBreakMode="TailTruncation" />

                                    <!-- Kwota pod kategorią -->
                                    <Label Grid.Row="0" Grid.Column="2" Text="{Binding AmountDisplay}" FontSize="10" TextColor="{DynamicResource AppTextColor}" Opacity="0.7" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Pusty stan nakłada się na całą siatkę -->
                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                           Text="{x:Static strings:AppResources.NoTransactionsLabel}" 
                           FontSize="14" 
                           TextColor="{DynamicResource AppTextColor}" 
                           Opacity="0.5" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasExpensesThisMonth}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>
            </Border>

            <!--WYŚWIETLANIE LISTY OSTATNICH TRANSAKCJI Z PODZIAŁEM NA GRUPY (DNI) - POCZĄTEK-->
            <Grid Grid.Row="4" RowDefinitions="Auto, Auto, *" Margin="0,20,0,0">

                <Label Grid.Row="0" Text="{x:Static strings:AppResources.RecentTransactionsLabel}" FontSize="20" FontAttributes="Bold" Margin="0,0,0,15" TextColor="{DynamicResource AppTextColor}"/>

                <Label Grid.Row="1" Text="{x:Static strings:AppResources.NoTransactionsLabel}" IsVisible="{Binding HasNoTransactions}" TextColor="{DynamicResource AppTextColor}" HorizontalOptions="Center" Margin="0,20,0,0" />

                <CollectionView Grid.Row="2" ItemsSource="{Binding GroupedTransactions}" IsGrouped="True" IsVisible="{Binding HasTransactions}">
                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate x:DataType="viewmodels:TransactionGroup">
                            <Border Margin="0,5,0,5" Padding="10,5" StrokeShape="RoundRectangle 6" StrokeThickness="0" BackgroundColor="{DynamicResource SectionBackgroundColor}" Opacity="0.9">
                                <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding DateDisplay}" FontAttributes="Bold" FontSize="14" TextColor="{DynamicResource AppTextColor}" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding DayOfWeekDisplay}" FontSize="14" TextColor="{DynamicResource AppTextColor}" Opacity="0.7" VerticalOptions="Center" TextTransform="Uppercase"/>

                                    <Label Grid.Column="3" Text="{Binding TotalIncomeDisplay}" FontSize="14" FontAttributes="Bold" TextColor="#4CAF50" VerticalOptions="Center" HorizontalOptions="End"/>
                                    <Label Grid.Column="4" Text="{Binding TotalExpenseDisplay}" FontSize="14" FontAttributes="Bold" TextColor="#E53935" VerticalOptions="Center" HorizontalOptions="End"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>

                    <CollectionView.ItemTemplate>
                        <!--<DataTemplate x:DataType="viewmodels:RecentTransactionItem">
                            <Grid Padding="5,10" ColumnDefinitions="2.5*, 3.5*, 2*, Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding CategoryName}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding SubcategoryName}" FontSize="11" TextColor="{DynamicResource AppTextColor}" Opacity="0.6" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Description}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding AccountDisplay}" FontSize="11" TextColor="{DynamicResource AppTextColor}" Opacity="0.6" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding ProjectName}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" Opacity="0.8" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding SubprojectName}" FontSize="10" TextColor="{DynamicResource AppTextColor}" Opacity="0.5" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                --><!-- Delegacja kolorowania na silnik stylów (Clean UI) --><!--
                                <Label Grid.Column="3" Text="{Binding AmountDisplay}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="End">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="{x:Static models:TransactionType.Expense}">
                                            <Setter Property="TextColor" Value="#E53935" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="{x:Static models:TransactionType.Income}">
                                            <Setter Property="TextColor" Value="#4CAF50" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="{x:Static models:TransactionType.Transfer}">
                                            <Setter Property="TextColor" Value="#1E88E5" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <BoxView Grid.ColumnSpan="4" HeightRequest="1" Color="{DynamicResource AppTextColor}" Opacity="0.1" VerticalOptions="End" Margin="0,15,0,-10"/>
                            </Grid>
                        </DataTemplate>-->
                        <DataTemplate x:DataType="viewmodels:TransactionDisplayItem">

                            <!-- Użycie współdzielonego komponentu z wpiętymi komendami z HomeViewModel -->
                            <views:TransactionRowControl 
                                EditCommand="{Binding BindingContext.EditTransactionCommand, Source={x:Reference MyHomePage}}"
                                DeleteCommand="{Binding BindingContext.DeleteTransactionCommand, Source={x:Reference MyHomePage}}" />

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <Button Text="+"
                FontSize="32"
                FontAttributes="Bold"
                WidthRequest="65"
                HeightRequest="65"
                CornerRadius="32" 
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,30"
                BackgroundColor="{DynamicResource PrimaryColor}"
                TextColor="{DynamicResource HeaderTextColor}"
                Command="{Binding NavigateToAddTransactionCommand}" />

    </Grid>
</ContentPage>