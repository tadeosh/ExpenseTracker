<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:ExpenseTracker.Resources.Strings"
             xmlns:viewmodels="clr-namespace:ExpenseTracker.ViewModels"
             xmlns:views="clr-namespace:ExpenseTracker.Views"
             x:Class="ExpenseTracker.Views.TransactionsPage"
             x:Name="MyTransactionsPage"
             Title="{Binding AccountName}"
             BackgroundColor="{DynamicResource AppBackgroundColor}">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="15">

        <!-- 1. WYSZUKIWARKA -->
        <SearchBar Grid.Row="0" 
                   Placeholder="{x:Static strings:AppResources.SearchPlaceholder}" 
                   Text="{Binding SearchText}"
                   TextColor="{DynamicResource AppTextColor}"
                   Margin="0,0,0,10"/>

        <!-- 2. FILTRY (Rozwijane w poziomie w ScrollView, żeby nie zaśmiecać ekranu) -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="10">
                <Border StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource SectionBackgroundColor}" Padding="10,0">
                    <Entry Placeholder="{x:Static strings:AppResources.MinAmountPlaceholder}" Text="{Binding MinAmountText}" Keyboard="Numeric" WidthRequest="100"/>
                </Border>
                <Border StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource SectionBackgroundColor}" Padding="10,0">
                    <Entry Placeholder="{x:Static strings:AppResources.MaxAmountPlaceholder}" Text="{Binding MaxAmountText}" Keyboard="Numeric" WidthRequest="100"/>
                </Border>
                <Border StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource SectionBackgroundColor}">
                    <Picker Title="{x:Static strings:AppResources.AllCategoriesLabel}" ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}" ItemDisplayBinding="{Binding Name}" TextColor="{DynamicResource AppTextColor}" TitleColor="{DynamicResource AppTextColor}" WidthRequest="150" Margin="10,0"/>
                </Border>
                <Border StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource SectionBackgroundColor}">
                    <Picker Title="{x:Static strings:AppResources.AllProjectsLabel}" ItemsSource="{Binding AvailableProjects}" SelectedItem="{Binding SelectedProject}" ItemDisplayBinding="{Binding Name}" TextColor="{DynamicResource AppTextColor}" TitleColor="{DynamicResource AppTextColor}" WidthRequest="150" Margin="10,0"/>
                </Border>
                <Grid IsVisible="{Binding IsGlobalView}">
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource SectionBackgroundColor}">
                        <Picker Title="{x:Static strings:AppResources.AccountLabel}" ItemsSource="{Binding AvailableAccounts}" SelectedItem="{Binding SelectedAccount}" ItemDisplayBinding="{Binding Name}" TextColor="{DynamicResource AppTextColor}" TitleColor="{DynamicResource AppTextColor}" WidthRequest="150" Margin="10,0" />
                    </Border>
                </Grid>
                <!-- Przycisk do czyszczenia filtrów -->
                <Button Text="X" BackgroundColor="Transparent" TextColor="#D32F2F" Command="{Binding ClearFiltersCommand}" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 3. KLIKALNE NAGŁÓWKI KOLUMN (Dopasowane do widoku dwuwierszowego) -->
    <Grid Grid.Row="2" ColumnDefinitions="2*, 2.5*, Auto" RowDefinitions="Auto, Auto" Padding="5,10" ColumnSpacing="10" RowSpacing="4" BackgroundColor="{DynamicResource PrimaryColor}">
        <Grid.Resources>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource HeaderTextColor}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </Grid.Resources>

        <!-- ================= WIERZ 1 ================= -->
        
        <!-- Kategoria (Kolumna 0) -->
        <HorizontalStackLayout Grid.Row="0" Grid.Column="0">
            <Label Text="{x:Static strings:AppResources.HeaderCategory}" />
            <Label Text="{Binding CategorySortIcon}" Margin="2,0,0,0" />
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SortByCommand}" CommandParameter="Category"/>
            </HorizontalStackLayout.GestureRecognizers>
        </HorizontalStackLayout>

        <!-- Opis (Kolumna 1) -->
        <HorizontalStackLayout Grid.Row="0" Grid.Column="1">
            <Label Text="{x:Static strings:AppResources.HeaderDescription}" />
            <Label Text="{Binding DescriptionSortIcon}" Margin="2,0,0,0" />
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SortByCommand}" CommandParameter="Description"/>
            </HorizontalStackLayout.GestureRecognizers>
        </HorizontalStackLayout>

        <!-- Kwota (Kolumna 2, zajmuje 2 rzędy tak jak na liście) -->
        <HorizontalStackLayout Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" HorizontalOptions="End" VerticalOptions="Center">
            <Label Text="{x:Static strings:AppResources.HeaderAmount}" />
            <Label Text="{Binding AmountSortIcon}" Margin="2,0,0,0" />
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SortByCommand}" CommandParameter="Amount"/>
            </HorizontalStackLayout.GestureRecognizers>
        </HorizontalStackLayout>


        <!-- ================= WIERZ 2 ================= -->
        
        <!-- Data i opcjonalnie Konto (Kolumna 0) -->
        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4" VerticalOptions="Center">
            <!-- Data -->
            <HorizontalStackLayout>
                <Label Text="{x:Static strings:AppResources.HeaderDate}" />
                <Label Text="{Binding DateSortIcon}" Margin="2,0,0,0" />
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SortByCommand}" CommandParameter="Date"/>
                </HorizontalStackLayout.GestureRecognizers>
            </HorizontalStackLayout>
            
            <!-- Separator i nagłówek Konta (tylko dla widoku globalnego) -->
            <Label Text="|" IsVisible="{Binding IsGlobalView}" Opacity="0.5"/>
            <HorizontalStackLayout IsVisible="{Binding IsGlobalView}">
                <Label Text="{x:Static strings:AppResources.AccountLabel}" />
                <Label Text="{Binding AccountSortIcon}" Margin="2,0,0,0" />
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SortByCommand}" CommandParameter="Account"/>
                </HorizontalStackLayout.GestureRecognizers>
            </HorizontalStackLayout>
        </HorizontalStackLayout>

        <!-- Projekt (Kolumna 1) -->
        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" VerticalOptions="Center">
            <Label Text="{x:Static strings:AppResources.HeaderProject}" />
            <Label Text="{Binding ProjectSortIcon}" Margin="2,0,0,0" />
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SortByCommand}" CommandParameter="Project"/>
            </HorizontalStackLayout.GestureRecognizers>
        </HorizontalStackLayout>
        
    </Grid>

        <!-- 4. LISTA TRANSAKCJI -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Transactions}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:TransactionDisplayItem">                   
                    <views:TransactionRowControl 
                        EditCommand="{Binding BindingContext.EditTransactionCommand, Source={x:Reference MyTransactionsPage}}"
                        DeleteCommand="{Binding BindingContext.DeleteTransactionCommand, Source={x:Reference MyTransactionsPage}}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        

        <!-- Pływający przycisk dodawania transakcji (na samym dole Gridu) -->
        <Button Grid.RowSpan="4"
                Text="+"
                FontSize="32"
                FontAttributes="Bold"
                WidthRequest="65"
                HeightRequest="65"
                CornerRadius="32" 
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,30"
                BackgroundColor="{DynamicResource PrimaryColor}"
                TextColor="{DynamicResource HeaderTextColor}"
                Command="{Binding NavigateToAddTransactionCommand}" />
    </Grid>
</ContentPage>
