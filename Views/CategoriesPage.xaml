<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:ExpenseTracker.Resources.Strings"
             xmlns:viewmodels="clr-namespace:ExpenseTracker.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ExpenseTracker.Views.CategoriesPage"             
             BackgroundColor="{DynamicResource AppBackgroundColor}"
             Title="{Binding PageTitle}"
             Shell.FlyoutBehavior="Disabled">



    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding GoBackCommand}" />
    </Shell.BackButtonBehavior>


    <Shell.TitleView>
        <Grid ColumnDefinitions="*, Auto" Padding="0,0,15,0">

            <Label Grid.Column="0" 
                   Text="{Binding PageTitle}" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="{DynamicResource HeaderTextColor}" 
                   VerticalOptions="Center" />

            <Path Grid.Column="1" 
                  Data="M 12 5 L 12 19 M 5 12 L 19 12"
                  Fill="Transparent" 
                  Stroke="{DynamicResource HeaderTextColor}" 
                  StrokeThickness="2"
                  StrokeLineCap="Round" 
                  StrokeLineJoin="Round"
                  WidthRequest="24" 
                  HeightRequest="24" 
                  VerticalOptions="Center"
                  HorizontalOptions="End">
                <Path.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenAddFormCommand}" />
                </Path.GestureRecognizers>
            </Path>

        </Grid>
    </Shell.TitleView> 

    <VerticalStackLayout Spacing="0">
        <VerticalStackLayout Padding="20" Spacing="15" 
                             BackgroundColor="{DynamicResource SectionBackgroundColor}" 
                             IsVisible="{Binding IsFormVisible}">

            <Entry Placeholder="{x:Static strings:AppResources.CategoryNameLabel}" 
                   Text="{Binding CategoryName}" 
                   TextColor="{DynamicResource AppTextColor}" />

            <VerticalStackLayout Spacing="5">
                <Label Text="{x:Static strings:AppResources.CategoryColorLabel}" FontSize="12" TextColor="{DynamicResource AppTextColor}" Opacity="0.7" Margin="5,0,0,0"/>

                <CollectionView ItemsSource="{Binding AvailableColors}" 
                         SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                         SelectionMode="Single"
                         HeightRequest="45" HorizontalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{Binding .}" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                <Border.Stroke>
                                    <SolidColorBrush Color="{DynamicResource AppTextColor}"/>
                                </Border.Stroke>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="StrokeThickness" Value="0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="StrokeThickness" Value="3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <Button Grid.Column="0" Text="{x:Static strings:AppResources.AddCategoryBtn}" Command="{Binding SaveCategoryCommand}" BackgroundColor="{DynamicResource PrimaryColor}" TextColor="White">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="0" Text="{x:Static strings:AppResources.SaveChangesBtn}" Command="{Binding SaveCategoryCommand}" BackgroundColor="{DynamicResource PrimaryColor}" TextColor="White" IsVisible="{Binding IsEditing}" />

                <Button Grid.Column="1" Text="{x:Static strings:AppResources.CancelBtn}" Command="{Binding CancelEditCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource AppTextColor}" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView ItemsSource="{Binding Categories}" Margin="20" VerticalOptions="Fill">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="15,10" StrokeShape="RoundRectangle 8" StrokeThickness="2" Stroke="Transparent" BackgroundColor="{DynamicResource SectionBackgroundColor}">

                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsBeingDragged}" Value="True">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Scale" Value="0.95" />
                            </DataTrigger>

                            <DataTrigger TargetType="Border" Binding="{Binding IsDragTarget}" Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource PrimaryColor}" />
                                <Setter Property="StrokeThickness" Value="1" />
                                <Setter Property="Scale" Value="1.02" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Border.GestureRecognizers>
                            <DropGestureRecognizer AllowDrop="True"
                                                   DragOverCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoriesViewModel}}, Path=DragOverCommand}"
                                                   DragOverCommandParameter="{Binding .}"
                                                   DragLeaveCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoriesViewModel}}, Path=DragLeaveCommand}"
                                                   DragLeaveCommandParameter="{Binding .}"
                                                   DropCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoriesViewModel}}, Path=DropCommand}"
                                                   DropCommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="15">

                            <Path Grid.Column="0" 
                                  Data="M 12 22 c 5.523 0 10 -4.477 10 -10 S 17.523 2 12 2 S 2 6.477 2 12 s 4.477 10 10 10 z M 8 12 h 8"
                                  Fill="Transparent" StrokeThickness="2" 
                                  StrokeLineCap="Round" StrokeLineJoin="Round"
                                  VerticalOptions="Center" HorizontalOptions="Center" Rotation="{Binding MinusRotation}">
                                <Path.Stroke>
                                    <SolidColorBrush Color="#D32F2F" />
                                </Path.Stroke>
                                <Path.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoriesViewModel}}, Path=ToggleDeleteModeCommand}" CommandParameter="{Binding .}"/>
                                </Path.GestureRecognizers>
                            </Path>

                            <Grid Grid.Column="1" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Fill" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoriesViewModel}}, Path=OpenSubcategoriesCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Ellipse Grid.Column="0" WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding CategoryColor}" />
                                    </Ellipse.Fill>
                                </Ellipse>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">

                                    <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="{Binding FontSize}" TextColor="{DynamicResource AppTextColor}" />

                                    <Label Text="{Binding SubcategoriesText}" 
                                           FontSize="12" 
                                           TextColor="{DynamicResource AppTextColor}" 
                                           Opacity="0.5" 
                                           LineBreakMode="TailTruncation" 
                                           MaxLines="1" 
                                           IsVisible="{Binding HasSubcategories}" />

                                </VerticalStackLayout>

                                <Path Grid.Column="2" Data="M 9 18 L 15 12 L 9 6" Fill="Transparent" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round" VerticalOptions="Center" Opacity="0.3">
                                    <Path.Stroke>
                                        <SolidColorBrush Color="{DynamicResource AppTextColor}" />
                                    </Path.Stroke>
                                </Path>
                            </Grid>

                            <Grid Grid.Column="2" VerticalOptions="Center" WidthRequest="36" HeightRequest="36">
                                <Border StrokeThickness="0" BackgroundColor="Transparent" Padding="0">

                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsDeleteMode}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Path Data="M 12 20 L 21 20 M 16.5 3.5 L 20.5 7.5 L 8.5 19.5 L 3.5 20.5 L 4.5 15.5 Z M 14.5 5.5 L 18.5 9.5"
                                          Fill="Transparent" StrokeThickness="2"
                                          StrokeLineCap="Round" StrokeLineJoin="Round"
                                          WidthRequest="24" HeightRequest="24"
                                          HorizontalOptions="Center" VerticalOptions="Center">
                                        <Path.Stroke>
                                            <SolidColorBrush Color="{DynamicResource AppTextColor}" />
                                        </Path.Stroke>
                                    </Path>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoriesViewModel}}, Path=EditCategoryCommand}" CommandParameter="{Binding Category}"/>
                                    </Border.GestureRecognizers>
                                </Border>

                                <Border StrokeShape="RoundRectangle 8" BackgroundColor="#D32F2F" StrokeThickness="0" IsVisible="{Binding IsDeleteMode}">

                                    <Path Data="M 3 6 h 18 M 19 6 v 14 c 0 1 -1 2 -2 2 H 7 c -1 0 -2 -1 -2 -2 V 6 M 8 6 V 4 c 0 -1 1 -2 2 -2 h 4 c 1 0 2 1 2 2 v 2 M 10 11 v 6 M 14 11 v 6"
                                          Fill="Transparent" StrokeThickness="2"
                                          StrokeLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalOptions="Center" VerticalOptions="Center">
                                        <Path.Stroke>
                                            <SolidColorBrush Color="#FFFFFF" />
                                        </Path.Stroke>
                                    </Path>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoriesViewModel}}, Path=DeleteCategoryCommand}" CommandParameter="{Binding Category}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>

                            <Path Grid.Column="3" Data="M 4 12 h 16 M 4 6 h 16 M 4 18 h 16"
                                  Fill="Transparent" StrokeThickness="2"
                                  StrokeLineCap="Round" StrokeLineJoin="Round"
                                  Opacity="0.4" VerticalOptions="Center" HorizontalOptions="Center">
                                <Path.Stroke>
                                    <SolidColorBrush Color="{DynamicResource AppTextColor}" />
                                </Path.Stroke>
                                <Path.GestureRecognizers>
                                    <DragGestureRecognizer CanDrag="True" 
                                                           DragStartingCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoriesViewModel}}, Path=DragStartedCommand}" 
                                                           DragStartingCommandParameter="{Binding .}"
                                                           DropCompletedCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoriesViewModel}}, Path=DragCompletedCommand}" />
                                </Path.GestureRecognizers>
                            </Path>

                        </Grid>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>