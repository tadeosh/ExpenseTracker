<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:ExpenseTracker.Resources.Strings"
             x:Class="ExpenseTracker.Views.ProjectsPage"
             Title="{x:Static strings:AppResources.ProjectsTitle}"
             BackgroundColor="{DynamicResource AppBackgroundColor}">

    <Grid RowDefinitions="Auto, *">
        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="10" BackgroundColor="{DynamicResource SectionBackgroundColor}">
            <Entry Placeholder="{x:Static strings:AppResources.CategoryNameLabel}" 
                   Text="{Binding ProjectName}" 
                   TextColor="{DynamicResource AppTextColor}" />

            <Button Text="{x:Static strings:AppResources.AddCategoryBtn}" 
                    Command="{Binding AddProjectCommand}" 
                    BackgroundColor="{DynamicResource PrimaryColor}" 
                    TextColor="{DynamicResource HeaderTextColor}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Projects}" Margin="20">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="15" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{DynamicResource SectionBackgroundColor}">
                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18" TextColor="{DynamicResource AppTextColor}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>