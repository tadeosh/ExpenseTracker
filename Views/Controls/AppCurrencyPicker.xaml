<?xml version="1.0" encoding="utf-8" ?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:currencyControls="clr-namespace:ExpenseTracker.Views.Controls" 
             x:Class="ExpenseTracker.Views.Controls.AppCurrencyPicker" 
             x:Name="Root">
    
    <Grid>
        <currencyControls:CurrencyPicker ItemsSource="{x:Null}" SelectedItem="{Binding SelectedItem, Source={x:Reference Root}, Mode=TwoWay}" 
                                         Title="{Binding Title, Source={x:Reference Root}}" BackgroundColor="Transparent" HorizontalOptions="Fill" />
        <Label Text="▼" TextColor="{DynamicResource AppTextColor}" FontSize="12" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,15,0" 
               InputTransparent="True" IsVisible="{OnPlatform Android=True, WinUI=False, iOS=True, MacCatalyst=True}" />
    </Grid>
</ContentView>
