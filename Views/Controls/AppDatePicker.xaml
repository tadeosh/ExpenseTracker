<?xml version="1.0" encoding="utf-8" ?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:ExpenseTracker.Views.Controls"
             x:Class="ExpenseTracker.Views.Controls.AppDatePicker" 
             x:Name="Root">
    <Grid>
        <local:AppPlatformDatePicker Date="{Binding Date, Source={x:Reference Root}, Mode=TwoWay}" MinimumDate="{Binding MinimumDate, Source={x:Reference Root}}" 
                                     MaximumDate="{Binding MaximumDate, Source={x:Reference Root}}" Format="{Binding Format, Source={x:Reference Root}}"
                                     TextColor="{Binding TextColor, Source={x:Reference Root}}" BackgroundColor="Transparent" HorizontalOptions="Fill" />
        <Image Source="calendar_days.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,15,0" 
               InputTransparent="True" IsVisible="{OnPlatform Android=True, WinUI=False}">
            <Image.Behaviors>
                <toolkit:IconTintColorBehavior TintColor="{Binding IconColor, Source={x:Reference Root}}" />
            </Image.Behaviors>
        </Image>
    </Grid>
</ContentView>
