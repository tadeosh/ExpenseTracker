<?xml version="1.0" encoding="utf-8" ?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:ExpenseTracker.Views.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="ExpenseTracker.Views.Controls.AppDatePicker"
             x:Name="Root">

    <Grid>

        <local:AppPlatformDatePicker x:Name="InnerDatePicker" Date="{Binding Date, Source={x:Reference Root}, Mode=TwoWay}" MinimumDate="{Binding MinimumDate, Source={x:Reference Root}}" 
                                     MaximumDate="{x:Static sys:DateTime.Today}" Format="{Binding Format, Source={x:Reference Root}}" 
                                     BackgroundColor="Transparent" HorizontalOptions="Fill" Opacity="0" InputTransparent="True" />

        <Grid ColumnDefinitions="*,Auto" Padding="8,10">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenPickerCommand, Source={x:Reference Root}}" />
            </Grid.GestureRecognizers>

            <Label Grid.Column="0" Text="{Binding DisplayText, Source={x:Reference Root}}" TextColor="{Binding TextColor, Source={x:Reference Root}}" 
                   VerticalOptions="Center" LineBreakMode="TailTruncation" InputTransparent="True" />

            <Image Grid.Column="1" Source="calendar_days.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" Margin="12,0,7,0" InputTransparent="True">
                <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{Binding IconColor, Source={x:Reference Root}}" />
                </Image.Behaviors>
            </Image>
        </Grid>

    </Grid>

</ContentView>
