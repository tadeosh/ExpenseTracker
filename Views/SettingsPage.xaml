<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:ExpenseTracker.Resources.Strings"
             x:Class="ExpenseTracker.Views.SettingsPage"
             Title="{x:Static strings:AppResources.SettingsTitle}"
             BackgroundColor="{DynamicResource AppBackgroundColor}">
    <ScrollView>
    
    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

        <Label Text="{x:Static strings:AppResources.LanguageLabel}"
               FontSize="24"
               HorizontalOptions="Center" 
               TextColor="{DynamicResource AppTextColor}"/>
        <Picker x:Name="LanguagePicker"
                Title="{x:Static strings:AppResources.LanguageLabel}"
                SelectedIndexChanged="OnLanguageChanged"
                HorizontalOptions="Center"
                WidthRequest="250" 
                TextColor="{DynamicResource AppTextColor}"
                TitleColor="{DynamicResource AppTextColor}"/>

        <Label Text="{x:Static strings:AppResources.DefaultCurrencyLabel}" FontSize="16" FontAttributes="Bold" Margin="0,20,0,5" TextColor="{DynamicResource AppTextColor}"/>
        <Picker x:Name="CurrencyPicker" 
                SelectedIndexChanged="OnCurrencyChanged"
                TextColor="{DynamicResource AppTextColor}"
                TitleColor="{DynamicResource AppTextColor}">
           
        </Picker>

        <Label Text="{x:Static strings:AppResources.ThemeLabel}"
               FontSize="24"
               HorizontalOptions="Center" 
               Margin="0,30,0,0" 
               TextColor="{DynamicResource AppTextColor}"/>
        <Picker x:Name="ThemePicker"
                Title="{x:Static strings:AppResources.ThemeLabel}"
                SelectedIndexChanged="OnThemeChanged"
                HorizontalOptions="Center"
                WidthRequest="250" 
                TextColor="{DynamicResource AppTextColor}"
                TitleColor="{DynamicResource AppTextColor}"/>

        <Label Text="{x:Static strings:AppResources.DataSettingsLabel}"
               FontSize="24"
               HorizontalOptions="Center" 
               Margin="0,30,0,0" 
               TextColor="{DynamicResource AppTextColor}"/>

        <Button Text="{x:Static strings:AppResources.ManageCategoriesBtn}"
                Clicked="OnManageCategoriesClicked"
                WidthRequest="250"
                BackgroundColor="{DynamicResource PrimaryColor}" 
                TextColor="{DynamicResource HeaderTextColor}"/>

        <Button Text="{x:Static strings:AppResources.ManageProjectsBtn}"
                Clicked="OnManageProjectsClicked"
                WidthRequest="250"
                BackgroundColor="{DynamicResource PrimaryColor}" 
                TextColor="{DynamicResource HeaderTextColor}"/>

        <Button Text="{x:Static strings:AppResources.ManageExchangeRatesTitle}"
                Clicked="OnManageExchangeRatesClicked"
                WidthRequest="250"
                Margin="0,0,0,20"
                BackgroundColor="{DynamicResource PrimaryColor}" 
                TextColor="{DynamicResource HeaderTextColor}"/>

        <Button Text="{x:Static strings:AppResources.ManageFavoriteCurrenciesBtn}"
            Clicked="OnManageFavoriteCurrenciesClicked"
            WidthRequest="250"
            Margin="0,0,0,20"
            BackgroundColor="{DynamicResource PrimaryColor}" 
            TextColor="{DynamicResource HeaderTextColor}"/>

        </VerticalStackLayout>
    </ScrollView>    
</ContentPage>