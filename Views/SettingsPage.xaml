<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:ExpenseTracker.Resources.Strings"
             xmlns:viewmodels="clr-namespace:ExpenseTracker.ViewModels"
             xmlns:controls="clr-namespace:ExpenseTracker.Views.Controls"
             xmlns:converters="clr-namespace:ExpenseTracker.Converters"
             x:Class="ExpenseTracker.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="{x:Static strings:AppResources.SettingsTitle}"
             BackgroundColor="{DynamicResource AppBackgroundColor}">

    <ContentPage.Resources>
        <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10" MaximumWidthRequest="720" HorizontalOptions="Center">

            <!-- USTAWIENIA OGÓLNE -->
            <Border Padding="20,10,20,10" StrokeThickness="0" BackgroundColor="{DynamicResource SectionBackgroundColor}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="{x:Static strings:AppResources.SettingsGeneralSection}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="{x:Static strings:AppResources.LanguageLabel}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" />
                        <controls:AppPicker ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" HorizontalOptions="Fill" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="{x:Static strings:AppResources.DefaultCurrencyLabel}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" />
                        <controls:AppCurrencyPicker SelectedItem="{Binding SelectedCurrency}" HorizontalOptions="Fill" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="{x:Static strings:AppResources.ThemeLabel}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" />
                        <controls:AppPicker ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" HorizontalOptions="Fill" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- ZARZĄDZANIE DANYMI -->
            <Border Padding="20,10,20,10" StrokeThickness="0" BackgroundColor="{DynamicResource SectionBackgroundColor}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="{x:Static strings:AppResources.DataSettingsLabel}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" />

                    <Button Text="{x:Static strings:AppResources.ManageCategoriesBtn}" Command="{Binding ManageCategoriesCommand}" BackgroundColor="{DynamicResource PrimaryColor}" TextColor="{DynamicResource HeaderTextColor}" />

                    <Button Text="{x:Static strings:AppResources.ManageProjectsBtn}" Command="{Binding ManageProjectsCommand}" BackgroundColor="{DynamicResource PrimaryColor}" TextColor="{DynamicResource HeaderTextColor}" />

                    <Button Text="{x:Static strings:AppResources.ManageExchangeRatesTitle}" Command="{Binding ManageExchangeRatesCommand}" BackgroundColor="{DynamicResource PrimaryColor}" TextColor="{DynamicResource HeaderTextColor}" />

                    <Button Text="{x:Static strings:AppResources.ManageFavoriteCurrenciesBtn}" Command="{Binding ManageFavoriteCurrenciesCommand}" BackgroundColor="{DynamicResource PrimaryColor}" TextColor="{DynamicResource HeaderTextColor}" />

                </VerticalStackLayout>
            </Border>

            <!-- BACKUP -->
            <Border Padding="20,10,20,10" StrokeThickness="0" BackgroundColor="{DynamicResource SectionBackgroundColor}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="{x:Static strings:AppResources.Backup_SectionTitle}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" />

                    <Label Text="{x:Static strings:AppResources.Backup_SectionDescription}" FontSize="13" TextColor="{DynamicResource AppTextColor}" Opacity="0.7" />

                    <Entry Text="{Binding BackupPassword}" Placeholder="{x:Static strings:AppResources.Backup_PasswordPlaceholder}" IsPassword="True" IsEnabled="{Binding IsBackupInteractionEnabled}" TextColor="{DynamicResource AppTextColor}" ClearButtonVisibility="WhileEditing" />

                    <Entry Text="{Binding BackupPasswordConfirmation}" Placeholder="{x:Static strings:AppResources.Backup_ConfirmPasswordPlaceholder}" IsPassword="True" IsEnabled="{Binding IsBackupInteractionEnabled}" TextColor="{DynamicResource AppTextColor}" ClearButtonVisibility="WhileEditing" />

                    <Label Text="{x:Static strings:AppResources.Backup_PasswordHint}" FontSize="11" TextColor="{DynamicResource AppTextColor}" Opacity="0.6" />

                    <Button Text="{x:Static strings:AppResources.Backup_CreateButton}" Command="{Binding CreateBackupCommand}" IsEnabled="{Binding IsBackupInteractionEnabled}" BackgroundColor="{DynamicResource PrimaryColor}" TextColor="{DynamicResource HeaderTextColor}" FontAttributes="Bold" />

                    <Label Text="{Binding BackupStatusMessage}" IsVisible="{Binding BackupStatusMessage, Converter={StaticResource StringNotEmptyConverter}}" FontSize="13" TextColor="{DynamicResource AppTextColor}" Opacity="0.85" HorizontalTextAlignment="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsBackupSuccess}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource ActivateActionColor}" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>

                            <DataTrigger TargetType="Label" Binding="{Binding IsBackupWarning}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource WarningMsgColor}" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Label Text="{Binding BackupErrorMessage}" IsVisible="{Binding BackupErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" FontSize="13" TextColor="{DynamicResource DeleteActionColor}" HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

            <!-- WALIDACJA KOPII DO PRZYSZŁEGO RESTORE -->
            <Border Padding="20,10,20,10" StrokeThickness="0" BackgroundColor="{DynamicResource SectionBackgroundColor}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="{x:Static strings:AppResources.Backup_ValidateSectionTitle}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" />

                    <Label Text="{x:Static strings:AppResources.Backup_ValidateSectionDescription}" FontSize="13" TextColor="{DynamicResource AppTextColor}" Opacity="0.7" />

                    <Entry Text="{Binding RestorePassword}" Placeholder="{x:Static strings:AppResources.Backup_RestorePasswordPlaceholder}" IsPassword="True" IsEnabled="{Binding IsBackupInteractionEnabled}" TextColor="{DynamicResource AppTextColor}" ClearButtonVisibility="WhileEditing" />

                    <Button Text="{x:Static strings:AppResources.Backup_PickAndValidateButton}" Command="{Binding PickAndValidateBackupCommand}" IsEnabled="{Binding IsBackupInteractionEnabled}" BackgroundColor="{DynamicResource PrimaryColor}" TextColor="{DynamicResource HeaderTextColor}" FontAttributes="Bold" />

                    <ActivityIndicator IsRunning="{Binding IsBackupOperationRunning}" IsVisible="{Binding IsBackupOperationRunning}" Color="{DynamicResource PrimaryColor}" HorizontalOptions="Center" />

                    <Label Text="{Binding RestoreStatusMessage}" IsVisible="{Binding RestoreStatusMessage, Converter={StaticResource StringNotEmptyConverter}}" FontSize="13"
                            TextColor="{DynamicResource AppTextColor}"  Opacity="0.85" HorizontalTextAlignment="Center">

                        <Label.Triggers>

                            <DataTrigger TargetType="Label" Binding="{Binding IsRestoreSuccess}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource ActivateActionColor}" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>

                            <DataTrigger TargetType="Label" Binding="{Binding IsRestoreWarning}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource WarningMsgColor}" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>

                        </Label.Triggers>

                    </Label>

                    <Label Text="{Binding RestoreErrorMessage}" IsVisible="{Binding RestoreErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" FontSize="13" TextColor="{DynamicResource DeleteActionColor}" HorizontalTextAlignment="Center" />

                    <Border Padding="12" Stroke="{DynamicResource PrimaryColor}" StrokeThickness="1" IsVisible="{Binding HasValidatedBackup}" BackgroundColor="Transparent">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="6" ColumnSpacing="12">

                            <Label Grid.Row="0" Grid.Column="0" Text="{x:Static strings:AppResources.Backup_FileNameLabel}" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding ValidatedBackupFileName}" TextColor="{DynamicResource AppTextColor}" LineBreakMode="TailTruncation" />

                            <Label Grid.Row="1" Grid.Column="0" Text="{x:Static strings:AppResources.Backup_CreatedAtLabel}" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding ValidatedBackupCreatedAt}" TextColor="{DynamicResource AppTextColor}" />

                            <Label Grid.Row="2" Grid.Column="0" Text="{x:Static strings:AppResources.Backup_AppVersionLabel}" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding ValidatedBackupAppVersion}" TextColor="{DynamicResource AppTextColor}" />

                            <Label Grid.Row="3" Grid.Column="0" Text="{x:Static strings:AppResources.Backup_SchemaVersionLabel}" FontAttributes="Bold" TextColor="{DynamicResource AppTextColor}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding ValidatedBackupSchemaVersion}" TextColor="{DynamicResource AppTextColor}" />

                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding HasValidatedBackup}">
                        <Button Grid.Column="0" Text="{x:Static strings:AppResources.Backup_CancelValidatedBackupButton}"  Command="{Binding CancelValidatedBackupCommand}" IsEnabled="{Binding IsBackupInteractionEnabled}"
                            BackgroundColor="Transparent"   TextColor="{DynamicResource AppTextColor}"  BorderColor="{DynamicResource AppTextColor}" BorderWidth="1" />      

                        <Button Grid.Column="1" Text="{x:Static strings:AppResources.Backup_RestoreButton}" Command="{Binding RestoreValidatedBackupCommand}" IsEnabled="{Binding IsBackupInteractionEnabled}"
                            BackgroundColor="{DynamicResource WarningMsgColor}" TextColor="White" FontAttributes="Bold" />

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- STREFA NIEBEZPIECZNA -->
            <Border Padding="20" Stroke="{DynamicResource DeleteActionColor}" StrokeThickness="1" BackgroundColor="{DynamicResource SectionBackgroundColor}" Margin="0,5,0,20">
                <VerticalStackLayout Spacing="12">

                    <Label Text="{x:Static strings:AppResources.DangerZone}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource DeleteActionColor}" HorizontalOptions="Center" />

                    <Button Text="{x:Static strings:AppResources.WipeDataBtn}" Command="{Binding WipeDataCommand}" IsEnabled="{Binding IsBackupInteractionEnabled}" BackgroundColor="{DynamicResource DeleteActionColor}" TextColor="White" FontAttributes="Bold" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
