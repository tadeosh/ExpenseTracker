<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ExpenseTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ExpenseTracker.Views"
    Shell.FlyoutBehavior="Flyout">

    <FlyoutItem Title="Strona Główna">
        <ShellContent 
            ContentTemplate="{DataTemplate views:HomePage}" 
            Route="HomePage" />
    </FlyoutItem>

    <FlyoutItem Title="Nowa Transakcja">
        <ShellContent 
            ContentTemplate="{DataTemplate views:AddTransactionPage}" 
            Route="AddTransactionPage" />
    </FlyoutItem>

    <FlyoutItem Title="Ustawienia">
        <ShellContent 
            ContentTemplate="{DataTemplate views:SettingsPage}" 
            Route="SettingsPage" />
    </FlyoutItem>

</Shell>
