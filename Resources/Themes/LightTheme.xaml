<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="ExpenseTracker.Resources.Themes.LightTheme">

    <Color x:Key="AppBackgroundColor">#F4F6F7</Color>
    <Color x:Key="SectionBackgroundColor">#FFFFFF</Color>
    <Color x:Key="AppTextColor">#202A32</Color>
    <Color x:Key="PrimaryColor">#087F8C</Color>
    <Color x:Key="HeaderTextColor">#172027</Color>
    <Color x:Key="WarningMsgColor">#B66A00</Color>
    <Color x:Key="ErrorMsgColor">#C73E4D</Color>

    <Color x:Key="EditActionColor">#087F9C</Color>
    <Color x:Key="DeleteActionColor">#C73E4D</Color>
    <Color x:Key="ActivateActionColor">#087F5B</Color>
    <Color x:Key="DeactivateActionColor">#B57300</Color>

    <Color x:Key="ValidationErrorColor">#C73E4D</Color>

    <!-- Kolory wykresów raportowych -->
    <Color x:Key="IncomeChartColor">#087F5B</Color>
    <Color x:Key="ExpenseChartColor">#C73E4D</Color>
    <Color x:Key="NetChartColor">#087F8C</Color>

    <Color x:Key="WealthChartColor">#096E8A</Color>
    <Color x:Key="WealthChangeChartColor">#7456A3</Color>

    <Color x:Key="ChartSegmentSeparatorColor">#D9E0E4</Color>

    <!-- Kolory semantyczne -->
    <Color x:Key="PositiveColor">#087F5B</Color>
    <Color x:Key="NegativeColor">#C73E4D</Color>
    <Color x:Key="NeutralColor">#087F8C</Color>

    <Color x:Key="SecondaryTextColor">#5F6B73</Color>
    <Color x:Key="BorderColor">#C5CED3</Color>
    <Color x:Key="DisabledColor">#929DA4</Color>

</ResourceDictionary>
