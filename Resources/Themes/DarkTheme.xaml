<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="ExpenseTracker.Resources.Themes.DarkTheme">
    <Color x:Key="AppBackgroundColor">#121212</Color>
    <Color x:Key="SectionBackgroundColor">#1E1E1E</Color>
    <Color x:Key="AppTextColor">#FDFDFD</Color>
    <Color x:Key="PrimaryColor">#9A83EE</Color>
    <Color x:Key="HeaderTextColor">#FFFFFF</Color>
    <Color x:Key="WarningMsgColor">#E89B43</Color>
    <Color x:Key="ErrorMsgColor">#D9534F</Color>

    <Color x:Key="EditActionColor">#1E88E5</Color>
    <Color x:Key="DeleteActionColor">#D9534F</Color>
    <Color x:Key="ActivateActionColor">#2E8B57</Color>
    <Color x:Key="DeactivateActionColor">#F9A825</Color>

    <!-- Kolory wykresów raportowych -->
    <Color x:Key="IncomeChartColor">#2E8B57</Color>
    <Color x:Key="ExpenseChartColor">#D9534F</Color>
    <Color x:Key="NetChartColor">#1E88E5</Color>

    <Color x:Key="WealthChartColor">#1E88E5</Color>
    <Color x:Key="WealthChangeChartColor">#8E44AD</Color>
